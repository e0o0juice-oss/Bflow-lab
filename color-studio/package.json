{
  "name": "color-discovery-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Three-hour instructor-led personal color workshop and participant workbook",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test server.test.cjs",
    "test:browser": "node --test browser.test.cjs report.browser.test.cjs safeguards.browser.test.cjs board.browser.test.cjs",
    "test:report": "npm test --prefix report",
    "build:report": "npm run build --prefix report"
  }
}
